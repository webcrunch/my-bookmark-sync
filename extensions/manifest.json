{
    "manifest_version": 3,
    "name": "Bookmark Sync Experiment",
    "version": "1.0",
    "description": "Synkar bokmärken med min egna dashboard",
    "permissions": [
        "bookmarks"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/books16.png",
        "48": "icons/books48.png",
        "128": "icons/books128.png"
    }
}