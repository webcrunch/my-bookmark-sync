    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst targetFolderId = String(body.targetFolderId || '0');\nconst categories = Array.isArray(body.categories) ? body.categories : [];\n\n// Values go to Postgres as parameters ($1–$3), never into the SQL text\nreturn categories\n  .filter(cat => Array.isArray(cat.bookmarkIds) && cat.bookmarkIds.length > 0)\n  .map(cat => ({\n    json: {\n      targetFolderId,\n      folderName: String(cat.folderName || 'Ny mapp').slice(0, 200),\n      bookmarkIds: JSON.stringify(cat.bookmarkIds.map(String))\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
