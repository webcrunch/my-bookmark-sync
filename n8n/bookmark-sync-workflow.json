      "parameters": {
        "jsCode": "// Hämta alla items från Postgres-noden\nconst allItems = $input.all();\n\n// Filtrera bort tomma items (objekt som saknar 'id') och mappa om\nconst changesList = allItems\n  .map(item => item.json)\n  .filter(data => data && data.id) // Släng bort tomma objekt!\n  .map(data => ({\n    ...data,\n    tempId: data.id\n  }));\n\n// Returnera alltid rätt format till Respond-noden\nreturn [\n  {\n    json: {\n      changes: changesList // Blir en helt tom array [] om inget fanns i Postgres\n    }\n  }\n];"
