        "messages": {
          "values": [
            {
              "content": "=Du är en strukturerad assistent för bokmärkesorganisering. \nGruppera följande bokmärken i 2 till 6 relevanta och koncisa undermappar baserat på deras titlar och sammanfattningar.\n\nBokmärken att organisera:\n{{ JSON.stringify($json.body.bookmarks) }}\n\nReturnera ENDAST giltig JSON utan markdown-block eller extra text i detta format:\n{\n  \"categories\": [\n    {\n      \"folderName\": \"Namn på undermapp\",\n      \"bookmarkIds\": [\"id1\", \"id2\"]\n    }\n  ]\n}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        144,
        736
      ],
      "id": "a4fbb9b0-9425-482e-ad71-5d974e7ca045",
      "name": "Message a model",
      "credentials": {
        "ollamaApi": {
          "id": "VgNxNiAh2YSlRvAa",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Hämta textsträngen från AI-nodens output\nconst item = $input.first().json;\nconst rawText = item.content || item.response || item.text || '';\n\nlet parsed = { categories: [] };\n\ntry {\n  // Regex som plockar ut allt mellan första { och sista }\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  // Fallback om parsing misslyckas\n  parsed = { categories: [] };\n}\n\n// Skicka med både målmappens ID och de parsade kategorierna\nreturn [{\n  json: {\n    targetFolderId: $('Webhook').first().json.body.folderId || '0',\n    categories: parsed.categories || []\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        736
      ],
      "id": "42f89a5c-0f14-4d81-821f-f552c7ec9a60",
      "name": "Code in JavaScript2"
